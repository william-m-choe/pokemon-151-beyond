      <aliases enabled='yes' />
      <column caption='Overall Rank' datatype='integer' name='[Calculation_1844750442373120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(MAX([total_stats]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank + Name' datatype='string' name='[Calculation_1844750500200449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;#&quot; + STR([overall_rank]) + &quot;  &quot; + [name]' />
      </column>
      <column caption='Gen 1 Highlight' datatype='string' name='[Calculation_1947829929353216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [generation] = &quot;Gen 1&quot; THEN &quot;Gen 1&quot;&#13;&#10;ELSE &quot;Other Generations&quot;&#13;&#10;END' />
